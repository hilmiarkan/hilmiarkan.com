---
import Base from '../layouts/Base.astro';
import HomeCards from '../components/HomeCards.tsx';
---

<Base preloadFonts={['helvetica-neue-thin', 'helvetica-neue-light']}>
  <!-- data-drag-area: the cards can be dragged anywhere inside this section. -->
  <section class="home" data-drag-area>
    <!-- client:load = make this React component interactive as soon as the page loads. -->
    <HomeCards client:load name="Hilmi Arkan" role="Designer" avatar="/images/avatar.avif" />
  </section>
</Base>

<style>
  .home {
    display: grid;
    place-items: center;
    height: 100%;
    overflow: hidden;
  }
</style>
