---
// The photo wall. Which photo goes in which column is set in src/data/photos.ts.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import { photoColumns, type Photo } from '../data/photos';

// Every file in src/assets/photos, keyed by file name.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*', { eager: true });
const byName = Object.fromEntries(Object.entries(files).map(([path, mod]) => [path.split('/').pop()!, mod.default]));

const resolve = (photo: Photo) => {
  const file = typeof photo === 'string' ? photo : photo.file;
  const image = byName[file];
  if (!image) throw new Error(`photos.ts lists "${file}" but src/assets/photos/${file} does not exist`);
  const options = typeof photo === 'string' ? {} : photo;
  return { image, alt: options.alt ?? '', ratio: options.ratio };
};

const columns = photoColumns.map((column) => column.map(resolve));

type GalleryPhoto = (typeof columns)[number][number];
const mobileColumns: [GalleryPhoto[], GalleryPhoto[]] = [[], []];
const rowCount = Math.max(0, ...columns.map((column) => column.length));
const mobilePhotos = Array.from({ length: rowCount }, (_, row) =>
  columns.flatMap((column) => column.slice(row, row + 1)),
).flat();
const heightAtUnitWidth = ({ image, ratio }: GalleryPhoto) =>
  ratio ? 1 / ratio : image.height / image.width;

// Keep both stacks filled in reading order and use the photo ratios to keep
// their bottoms close together at any viewport width.
let heightDifference = 0;
for (let index = 0; index < mobilePhotos.length; index += 2) {
  const first = mobilePhotos[index];
  const second = mobilePhotos[index + 1];
  if (!second) {
    mobileColumns[heightDifference <= 0 ? 0 : 1].push(first);
    break;
  }

  const pairDifference = heightAtUnitWidth(first) - heightAtUnitWidth(second);
  const keepOrder = Math.abs(heightDifference + pairDifference) <= Math.abs(heightDifference - pairDifference);
  mobileColumns[0].push(keepOrder ? first : second);
  mobileColumns[1].push(keepOrder ? second : first);
  heightDifference += keepOrder ? pairDifference : -pairDifference;
}

const layouts = [
  { name: 'desktop', columns },
  { name: 'mobile', columns: mobileColumns },
];
---

<Base title="Photos">
  {layouts.map((layout) => (
    <div class:list={['wall', `wall-${layout.name}`, 'appear']}>
      {layout.columns.map((photos, index) => (
        <div class="column" data-column={index + 1}>
          {photos.map(({ image, alt, ratio }, i) => (
            <Image
              class="photo"
              src={image}
              alt={alt}
              style={ratio ? `aspect-ratio: ${ratio}` : undefined}
              widths={[250, 500, 750]}
              sizes="(max-width: 1199.98px) 45vw, 250px"
              loading={i < 2 ? 'eager' : 'lazy'}
            />
          ))}
        </div>
      ))}
    </div>
  ))}
  <p class="closing-note appear">May He bless my work and help me use the internet for what benefits me and others.</p>
</Base>

<style>
  .wall {
    --gap: 24px;
    display: flex;
    align-items: flex-start;
    gap: var(--gap);
    padding: 24px 24px 0;
  }
  .closing-note {
    margin: 56px 24px;
    color: var(--text-secondary);
    font-size: 0.8125rem;
    line-height: 1.5;
    text-align: center;
  }
  .column {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }
  /* The fourth column starts lower, as in the original layout. */
  .wall-desktop .column[data-column="4"] { margin-top: 84px; }
  .photo {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border: 1px solid var(--media-border);
    border-radius: var(--radius-item);
  }

  .wall-mobile { display: none; }

  @media (max-width: 1199.98px) {
    .wall-desktop { display: none; }
    .wall-mobile {
      --gap: clamp(10px, 3vw, 18px);
      display: flex;
      padding: var(--gap) var(--gap) 0;
    }
  }
</style>
