# Cloudflare Pages response headers.

# Built assets have a fingerprint in their name, so they never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Media that keeps its name: cache for a day, then check again.
/images/*
  Cache-Control: public, max-age=86400
/videos/*
  Cache-Control: public, max-age=86400
/rive/*
  Cache-Control: public, max-age=86400
